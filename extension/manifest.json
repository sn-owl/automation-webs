{
  "manifest_version": 3,
  "name": "유지보수 게시판 모니터",
  "version": "1.0.0",
  "description": "유지보수 게시판 미처리 글 자동 감지 및 텔레그램 알림",

  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "tabs",
    "scripting",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "게시판 모니터"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
