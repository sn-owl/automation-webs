{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upmuzadong.local/schemas/pattern.schema.json",
  "title": "Pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "pattern_id",
    "kind",
    "state",
    "confidence",
    "evidence"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "rule",
        "evaluation_rule",
        "recipe",
        "skill",
        "manual_template"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "shadow",
        "active",
        "suspended",
        "retired"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition": {
      "description": "What the pattern becomes if promoted; for kind=rule, the {id, when, then} body.",
      "type": "object",
      "minProperties": 1
    }
  }
}
