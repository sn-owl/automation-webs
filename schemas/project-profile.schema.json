{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upmuzadong.local/schemas/project-profile.schema.json",
  "title": "ProjectProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "project_id",
    "name",
    "root",
    "managed_patterns",
    "managed_directories",
    "stack",
    "run_reference",
    "test_reference",
    "allow_full_codebase",
    "allow_external_ai_code"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "name": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "managed_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "managed_directories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stack": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "run_reference": {"type": ["string", "null"]},
    "test_reference": {"type": ["string", "null"]},
    "allow_full_codebase": {"type": "boolean"},
    "allow_external_ai_code": {"type": "boolean"},
    "database_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
