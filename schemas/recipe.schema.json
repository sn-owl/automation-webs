{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upmuzadong.local/schemas/recipe.schema.json",
  "title": "RecipeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe_id", "description", "executor", "input_type", "output_type", "scope"],
  "properties": {
    "recipe_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "executor": {"type": "string", "enum": ["restarea-converter", "excel-table", "code-analysis"]},
    "input_type": {"type": "string", "enum": ["hwpx", "hwp", "pdf", "docx", "xls", "xlsx", "zip", "jpg", "jpeg", "png", "gif", "code", "json", "csv"]},
    "output_type": {"type": "string", "enum": ["hwpx", "hwp", "pdf", "docx", "xls", "xlsx", "zip", "jpg", "jpeg", "png", "gif", "code", "json", "csv"]},
    "template": {"type": "string", "minLength": 1}
  },
  "patternProperties": {
    "^version$": {"type": "integer", "minimum": 1},
    "^steps$": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["operation", "parameters"], "properties": {"operation": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}}}},
    "^(required_conditions|exclusion_conditions|success_checks)$": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "^approval_scope$": {"type": "string", "minLength": 1},
    "^(applicability|recognition|execution|verification|error_policy|ai_policy)$": {"type": "object"}
  }
}
